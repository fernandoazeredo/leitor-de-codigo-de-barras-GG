rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function isAdminEmail() {
      return signedIn()
        && request.auth.token.email in [
          'fernandoazeredo64@gmail.com',
          'cassyomattos@gmail.com'
        ];
    }

    function isAdminBootstrap(uid) {
      return signedIn()
        && request.auth.uid == uid
        && isAdminEmail()
        && request.auth.token.email_verified == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.ativo == true
        && request.resource.data.perfil == 'ADMINISTRADOR';
    }

    function isSelfOperatorBootstrap(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.ativo == true
        && request.resource.data.perfil == 'OPERADOR';
    }

    function isActive() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.ativo == true;
    }

    function isAdmin() {
      return isActive()
        && get(userPath(request.auth.uid)).data.perfil == 'ADMINISTRADOR';
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() || isAdminBootstrap(uid) || isSelfOperatorBootstrap(uid);
      allow update, delete: if isAdmin();
    }

    match /produtos_fabricantes/{docId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    match /produtos_gg/{docId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    match /correspondencias/{docId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    match /historico_comparacoes/{docId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
